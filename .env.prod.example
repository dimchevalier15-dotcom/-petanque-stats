# Production environment — copy to `.env` on the VPS (or use `--env-file .env.prod`).
# Never commit the real file. Values below are placeholders only.

# --- Symfony ---
APP_ENV=prod
APP_DEBUG=0
APP_SECRET=generate-a-random-hex-string
DEFAULT_URI=https://api.petanque-analytics.com

# Must match MYSQL_USER / MYSQL_PASSWORD / MYSQL_DATABASE below.
# URL-encode reserved characters in the password.
DATABASE_URL=mysql://petanque:change-me@mysql:3306/petanque?serverVersion=8.0&charset=utf8mb4

# Resend (never commit the real key). Symfony interpolates RESEND_API_KEY inside MAILER_DSN.
RESEND_API_KEY=
MAILER_DSN=resend+api://%env(RESEND_API_KEY)%@default
MAIL_FROM=noreply@petanque-analytics.com
MAIL_FROM_NAME="Pétanque Analytics"
FRONTEND_BASE_URL=https://petanque-analytics.com

# Mobile app version policy (public GET /api/config)
APP_LATEST_VERSION=1.5.0
APP_MINIMUM_VERSION=1.5.0
APP_ANDROID_STORE_URL=https://play.google.com/store/apps/details?id=com.petanquestats.app
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
SYMFONY_TRUSTED_PROXIES=REMOTE_ADDR

# --- MySQL (not published on the host) ---
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=petanque
MYSQL_USER=petanque
MYSQL_PASSWORD=change-me

# --- JWT (keys live in ./jwt on the host, mounted read-only) ---
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=change-me

# --- Caddy / Let's Encrypt ---
CADDY_ACME_EMAIL=admin@petanque-analytics.com

# --- Frontend build (baked into the static bundle at image build time) ---
VITE_API_URL=https://api.petanque-analytics.com/api
