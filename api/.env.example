# Symfony / API environment (copy to `.env` and adjust).
# Never commit `.env` with real secrets.

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=change_me_generate_with_openssl_rand_hex_16
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
# Docker dev default (service name `mysql` in docker-compose.yml)
DATABASE_URL="mysql://petanque:petanque@mysql:3306/petanque?serverVersion=8.0&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> lexik/jwt-authentication-bundle ###
# Generate keys once:
#   mkdir -p config/jwt
#   openssl genrsa -aes256 -out config/jwt/private.pem -passout pass:YOUR_PASSPHRASE 4096
#   openssl rsa -pubout -in config/jwt/private.pem -out config/jwt/public.pem -passin pass:YOUR_PASSPHRASE
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=change_me
###< lexik/jwt-authentication-bundle ###

###> nelmio/cors-bundle ###
# Dev: Vite on port 5173. Prod: front origin if API is on another host.
CORS_ALLOW_ORIGIN=http://localhost:5173
###< nelmio/cors-bundle ###

MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
MAILER_DSN=null://null
DEFAULT_URI=http://localhost
