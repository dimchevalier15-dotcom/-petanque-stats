{
  "name": "petanque-analytics-mobile",
  "version": "1.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host",
    "lint": "biome lint --files-ignore-unknown=true .",
    "format": "biome format --write .",
    "fix": "biome check --write .",
    "test": "vitest run",
    "test:ui": "vitest",
    "build:android": "vite build && cap sync android",
    "android:sync": "cap sync android",
    "android:open": "cap open android",
    "android:bundle": "vite build && node scripts/verify-production-api-url.mjs && cap sync android && npm run android:bundle:gradle",
    "android:bundle:gradle": "cd android && ./gradlew bundleRelease",
    "assets:android": "capacitor-assets generate --android --assetPath resources --iconBackgroundColor '#FFFFFF' --iconBackgroundColorDark '#FFFFFF' --splashBackgroundColor '#FFFFFF' --splashBackgroundColorDark '#FFFFFF'"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.0",
    "@primeuix/themes": "^3.0.0",
    "axios": "^1.7.2",
    "chart.js": "^4.5.1",
    "pinia": "^2.2.6",
    "primeicons": "^7.0.0",
    "primevue": "^4.2.1",
    "qrcode": "^1.5.4",
    "vue": "^3.4.38",
    "vue-i18n": "^9.14.0",
    "vue-router": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.8.3",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.0",
    "@types/node": "^20.14.10",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^5.1.2",
    "typescript": "^5.5.4",
    "vite": "^5.4.0",
    "vitest": "^2.0.5"
  }
}
